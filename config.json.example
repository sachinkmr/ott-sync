{
  "_comment_radarr": "Radarr configuration - URL and API key for movie management",
  "radarr_url": "http://your-radarr-server:7878",
  "radarr_api_key": "YOUR_RADARR_API_KEY_HERE",
  
  "_comment_sonarr": "Sonarr configuration - URL and API key for series management",
  "sonarr_url": "http://your-sonarr-server:8989",
  "sonarr_api_key": "YOUR_SONARR_API_KEY_HERE",
  
  "_comment_ott_providers": "List of OTT providers to check (case-sensitive, must match JustWatch provider names)",
  "ott_providers": ["Netflix", "Prime Video", "Disney Plus Hotstar"],
  
  "_comment_telegram": "Telegram bot configuration for notifications and interactive buttons. chat_id receives all normal alerts; admin_chat_id (optional) receives anime-maybe confirmation prompts only - leave empty to route them to chat_id instead.",
  "telegram": {
    "enabled": true,
    "bot_token": "YOUR_TELEGRAM_BOT_TOKEN_HERE",
    "chat_id": "YOUR_TELEGRAM_CHAT_ID_HERE",
    "admin_chat_id": "",
    "region": "India"
  },
  
  "_comment_region": "JustWatch region code (IN, US, GB, etc.) - must match your location",
  "region": "IN",
  
  "_comment_cron": "Scheduled cleanup configuration",
  "cron_initial_delay_seconds": 60,
  "cron_interval_hours": 24,
  
  "_comment_verification": "Delay before verifying item wasn't grabbed (prevents race conditions)",
  "verification_delay_seconds": 60,
  
  "_comment_auto_download": "Download mode: true = automatic (current behavior), false = manual approval required for ALL items",
  "auto_download": false,

  "_comment_wakeup": "Optional /wakeup endpoint target (Wake-on-LAN). Leave both empty to disable.",
  "wakeup": {
    "mac_address": "",
    "broadcast_address": ""
  },
  
  "_comment_rating_gate": "When auto_download=true AND rating_gate.enabled=true, items NOT on OTT are subject to threshold-based gating: high-rated items auto-download, mid-range items trigger a Telegram approval prompt, low-rated items are skipped, and items with no rating are deferred for weekly re-evaluation. Disabled by default.",
  "rating_gate": {
    "enabled": false,
    "auto_download_threshold_pct": 80,
    "approval_threshold_pct": 70,
    "min_vote_count": 50,
    "trending_window": "week",
    "defer_days_on_no_rating": 7,
    "max_defer_attempts": 0
  },

  "_comment_omdb": "Optional OMDb API key for IMDb ratings in Telegram notifications. Get a free key (1,000 req/day) at https://www.omdbapi.com/apikey.aspx. Leave api_key empty to disable.",
  "omdb": {
    "api_key": "",
    "rate_limit_calls": 50,
    "rate_limit_period": 60
  },

  "_comment_manual_add_detection": "Auto-exempt manually added items from OTT/rating logic. Works by inverse-tag matching: if an item carries NONE of the listed import-list tags, it's treated as user-added and ott-override is applied. Requires each import list in Radarr/Sonarr to apply an identifying tag.",
  "manual_add_detection": {
    "enabled": false,
    "import_list_tags": ["list-trakt", "list-imdb", "list-plex-watchlist"],
    "auto_apply_override_tag": true,
    "tag_recheck_delay_ms": 1500
  },

  "_comment_webhook_events": "Webhook events to process (MovieAdded, SeriesAdded, Grab, etc.)",
  "webhook_events": [
    "MovieAdded",
    "SeriesAdded"
  ],
  
  "_comment_justwatch_rate_limit": "JustWatch API rate limiting to avoid throttling",
  "justwatch_rate_limit": {
    "max_calls": 60,
    "period_seconds": 60
  },
  
  "_comment_database": "SQLite database configuration (v2.0.0+)",
  "database": {
    "_comment": "Database will be created at /config/ott-hooks.db (in Docker volume)",
    "path": "/config/ott-hooks.db",
    "enable_wal": true,
    "backup_enabled": false,
    "backup_interval_hours": 24
  },
  
  "_comment_cache": "JustWatch cache configuration for performance optimization (v2.0.0+)",
  "cache": {
    "_comment": "Caching reduces API calls and improves response time",
    "enabled": true,
    "ttl_found_days": 7,
    "ttl_not_found_hours": 24,
    "max_size_mb": 50
  },
  
  "_comment_performance": "Performance tuning options (v2.0.0+)",
  "performance": {
    "_comment": "Adjust these based on your system resources",
    "max_concurrent_webhooks": 5,
    "max_concurrent_justwatch_calls": 10,
    "enable_async_processing": false
  },
  
  "_comment_metrics": "Metrics retention configuration (v2.0.0+)",
  "metrics": {
    "_comment": "Metrics older than this will be automatically deleted",
    "retention_days": 90
  },
  
  "_comment_anime_detection": "Anime detection system (optional feature)",
  "anime_detection": {
    "enabled": false,
    "api": {
      "_comment": "Get free TMDB API key from https://www.themoviedb.org/settings/api",
      "tmdb_api_key": "",
      "tmdb_rate_limit": {
        "max_calls": 40,
        "period_seconds": 10
      },
      "anilist_enabled": true,
      "anilist_rate_limit": {
        "max_calls": 90,
        "period_seconds": 60
      }
    },
    "detection": {
      "require_anilist_match": false,
      "process_all_anilist_results": true
    },
    "metadata": {
      "auto_set_series_type": true,
      "auto_set_profile": true,
      "profile_name": "Anime",
      "skip_if_profile_contains_anime": true
    },
    "tags": {
      "checked": "anime-checked",
      "detected": "anime-detected",
      "maybe": "anime-maybe"
    },
    "telegram": {
      "notify_maybe": true,
      "notify_detected": false
    },
    "migration": {
      "_comment": "immediate: run on startup, manual: use CLI, disabled: skip migration",
      "mode": "immediate",
      "auto_run_on_startup": true,
      "parallel_processing": true
    }
  }
}
